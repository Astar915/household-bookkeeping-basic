{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "household-bookkeeping-python-d1-engine-a-stage",
  "main": "src/worker.py",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": [
    "python_workers"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "PRIVATE_ENGINE": "1"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "household-bookkeeping-cloud-python-d1-stage",
      "database_id": "0f3c40a9-77e2-40ad-88dc-6a9c015f187b",
      "migrations_dir": "schema"
    }
  ],
  "workflows": [
    {
      "name": "household-bookkeeping-app-jobs-stage",
      "binding": "APP_JOBS",
      "class_name": "AppJobWorkflow",
      "script_name": "household-bookkeeping-python-d1-jobs-stage"
    }
  ],
  "observability": {
    "enabled": true
  }
}
