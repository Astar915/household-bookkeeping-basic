{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "household-bookkeeping-python-d1-stage",
  "main": "edge/index.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "secrets": {
    "required": ["TOKEN_ENCRYPTION_KEY", "APP_JOB_SHARED_SECRET"]
  },
  "vars": {
    "GITEE_REDIRECT_URI": "https://household-bookkeeping-python-d1-stage.household-bookkeeping-cloud-test.workers.dev/api/auth/gitee/callback"
  },
  "services": [
    { "binding": "PYTHON_PRIMARY", "service": "household-bookkeeping-python-d1-engine-a-stage" },
    { "binding": "PYTHON_SECONDARY", "service": "household-bookkeeping-python-d1-engine-b-stage" }
  ],
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/__internal/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "household-bookkeeping-cloud-python-d1-stage",
      "database_id": "0f3c40a9-77e2-40ad-88dc-6a9c015f187b",
      "migrations_dir": "schema"
    }
  ],
  "workflows": [
    {
      "name": "household-bookkeeping-app-jobs-stage",
      "binding": "APP_JOBS",
      "class_name": "AppJobWorkflow",
      "script_name": "household-bookkeeping-python-d1-jobs-stage"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": { "enabled": true }
}
