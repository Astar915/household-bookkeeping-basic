{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "household-bookkeeping-python-d1-jobs-stage",
  "main": "src/index.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "secrets": {
    "required": ["APP_JOB_SHARED_SECRET"]
  },
  "services": [
    {
      "binding": "PYTHON_API",
      "service": "household-bookkeeping-python-d1-stage"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "household-bookkeeping-cloud-python-d1-stage",
      "database_id": "0f3c40a9-77e2-40ad-88dc-6a9c015f187b"
    }
  ],
  "workflows": [
    {
      "name": "household-bookkeeping-app-jobs-stage",
      "binding": "APP_JOBS",
      "class_name": "AppJobWorkflow"
    }
  ],
  "observability": { "enabled": true }
}
